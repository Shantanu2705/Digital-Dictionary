rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication Checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Role Resolution with safe short-circuit evaluation
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'coo@digitaldictionary.in' ||
        request.auth.token.role == 'super_admin' || 
        (hasUserData() && getUserData().role == 'super_admin')
      );
    }
    
    function isHRManager() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        request.auth.token.role == 'hr_manager' ||
        (hasUserData() && getUserData().role == 'hr_manager')
      );
    }
    
    function isFinanceManager() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        request.auth.token.role == 'finance_manager' ||
        (hasUserData() && getUserData().role == 'finance_manager')
      );
    }

    // System Collection: Strictly restricted to Admin SDK server runtime
    match /system/{document=**} {
      allow read, write: if false; // Zero client access
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        isHRManager()
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus', 'employeeId', 'employmentType'])
        )
      );
      allow create: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.primaryEmployeeId == request.auth.uid ||
        request.auth.uid in resource.data.assignedEmployeeIds ||
        isFinanceManager()
      ));
      allow create, update, delete: if isSuperAdmin();
    }

    // Team Project Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    match /clientAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Permanent Employees & Interns Records
    match /employees/{employeeId} {
      allow read: if isSuperAdmin() || isHRManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || employeeId == request.auth.uid));
      allow write: if isSuperAdmin() || isHRManager();
    }
    
    match /interns/{internId} {
      allow read: if isSuperAdmin() || isHRManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || internId == request.auth.uid));
      allow write: if isSuperAdmin() || isHRManager();
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.relatedUserId == request.auth.uid ||
        request.auth.uid in resource.data.assignedEmployeeIds ||
        isFinanceManager() ||
        isHRManager()
      ));
      allow create, update, delete: if isSuperAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Document Sequences
    match /sequences/{sequenceName} {
      allow read, write: if isSuperAdmin();
    }

    // Service Packages & Catalogue (Authenticated internal reads only; Admin writes)
    match /packages/{pkgId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Client-Specific Custom Pricing Proposals (Strictly Super Admin)
    match /custom_packages/{customId} {
      allow read, write: if isSuperAdmin();
    }

    // Company Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Payroll Records
    match /payroll/{recordId} {
      allow read: if isSuperAdmin() || isFinanceManager() || (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if isSuperAdmin() || isFinanceManager();
    }

    // Invoices & Billing
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isFinanceManager() || (isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.assignedEmployeeId == request.auth.uid
      ));
      allow write: if isSuperAdmin() || isFinanceManager();
    }
  }
}
