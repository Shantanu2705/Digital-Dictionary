rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication Checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Role Resolution (Direct Claim or Database Role)
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        getUserData().role == 'super_admin' || 
        request.auth.token.email == 'coo@digitaldictionary.in'
      );
    }
    
    function isHRManager() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        request.auth.token.role == 'hr_manager' ||
        getUserData().role == 'hr_manager'
      );
    }
    
    function isFinanceManager() {
      return isAuthenticated() && (
        isSuperAdmin() || 
        request.auth.token.role == 'finance_manager' ||
        getUserData().role == 'finance_manager'
      );
    }

    // System Collection: Strictly restricted to Admin SDK server runtime
    match /system/{document=**} {
      allow read, write: if false; // Zero client access
    }

    // Users Collection (Zero Privilege Escalation)
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        isHRManager()
      );
      // Users can update their own profile details, but CANNOT elevate their role or alter account status
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus', 'employeeId', 'employmentType'])
        )
      );
      allow create, delete: if isSuperAdmin();
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.primaryEmployeeId == request.auth.uid ||
        request.auth.uid in resource.data.assignedEmployeeIds ||
        isFinanceManager()
      ));
      allow create, update, delete: if isSuperAdmin();
    }

    // Team Project Assignments (both collection aliases)
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    match /clientAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Permanent Employees & Interns Records
    match /employees/{employeeId} {
      allow read: if isSuperAdmin() || isHRManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || employeeId == request.auth.uid));
      allow write: if isSuperAdmin() || isHRManager();
    }
    
    match /interns/{internId} {
      allow read: if isSuperAdmin() || isHRManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || internId == request.auth.uid));
      allow write: if isSuperAdmin() || isHRManager();
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.relatedUserId == request.auth.uid ||
        request.auth.uid in resource.data.assignedEmployeeIds ||
        isFinanceManager() ||
        isHRManager()
      ));
      allow create, update: if isSuperAdmin() || isHRManager() || isFinanceManager();
      allow delete: if isSuperAdmin();
    }

    // Document Templates
    match /documentTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Service Packages Catalogue (Public Read, Admin Write)
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Custom Tailored Packages
    match /custom_packages/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    match /customPackages/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Monthly Remuneration & Payslips
    match /payslips/{payslipId} {
      allow read: if isSuperAdmin() || isFinanceManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isSuperAdmin() || isFinanceManager();
    }

    // Onboarding SLA Desk
    match /onboardingTasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Audit Logs (Immutable append-only, zero tampering)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }
    match /activityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    // Company Governance Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /companySettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Atomic Document Numbering Counters
    match /documentCounters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Internal Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isSuperAdmin());
      allow write: if isAuthenticated();
    }
  }
}
